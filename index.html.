<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <title>Attack on Titan - Phong Cảnh 3D</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; touch-action: none; }
    html, body {
      width: 100%; height: 100%; overflow: hidden;
      background: #0a0908; font-family: system-ui, -apple-system, sans-serif;
      color: #e8e0d0; position: fixed;
    }
    #canvas-container { width: 100%; height: 100%; }
    canvas { display: block; width: 100% !important; height: 100% !important; }

    #ui {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      pointer-events: none; text-shadow: 0 2px 6px rgba(0,0,0,0.9);
    }

    #title {
      position: absolute; top: max(12px, env(safe-area-inset-top));
      left: 50%; transform: translateX(-50%); text-align: center; opacity: 0.9;
    }
    #title h1 {
      font-size: 1.15rem; font-weight: 600; letter-spacing: 3px; color: #c9b8a0;
    }
    #title p { font-size: 0.7rem; opacity: 0.65; margin-top: 2px; }

    /* ===== Mobile controls ===== */
    #joystick-zone {
      position: absolute; left: 0; bottom: 0;
      width: 45%; height: 42%; pointer-events: auto;
    }
    #joystick-base {
      position: absolute; left: 28px; bottom: 36px;
      width: 110px; height: 110px; border-radius: 50%;
      background: rgba(255,255,255,0.08); border: 2px solid rgba(255,255,255,0.18);
      display: none;
    }
    #joystick-stick {
      position: absolute; width: 48px; height: 48px; border-radius: 50%;
      background: rgba(220, 200, 160, 0.45); border: 2px solid rgba(255,255,255,0.35);
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      pointer-events: none;
    }

    #look-hint {
      position: absolute; right: 16px; bottom: 50px;
      font-size: 0.72rem; color: rgba(200,180,150,0.55); text-align: right;
      line-height: 1.35; display: none;
    }

    #sprint-btn {
      position: absolute; right: 22px; bottom: 140px;
      width: 64px; height: 64px; border-radius: 50%;
      background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.22);
      display: none; align-items: center; justify-content: center;
      font-size: 0.7rem; color: #d0c0a0; pointer-events: auto;
      user-select: none; -webkit-user-select: none;
    }
    #sprint-btn.active {
      background: rgba(200, 160, 80, 0.35); border-color: rgba(220,180,100,0.5);
    }

    /* Desktop instructions */
    #desktop-hint {
      position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%);
      background: rgba(15,13,11,0.75); padding: 8px 16px; border-radius: 6px;
      font-size: 0.8rem; border: 1px solid rgba(180,160,130,0.2); display: none;
    }
    #desktop-hint kbd {
      background: rgba(255,255,255,0.12); padding: 1px 5px; border-radius: 3px; margin: 0 1px;
    }

    #blocker {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(8,6,5,0.93); display: flex; flex-direction: column;
      align-items: center; justify-content: center; pointer-events: auto;
      z-index: 20; padding: 20px; text-align: center;
    }
    #blocker h2 {
      font-size: 1.5rem; color: #d4c4a8; margin-bottom: 8px; letter-spacing: 2px;
    }
    #blocker p { color: #a09080; font-size: 0.95rem; margin-bottom: 4px; }
    #blocker .hint {
      margin-top: 24px; font-size: 1rem; color: #c0b090;
      animation: pulse 1.8s infinite; padding: 12px 28px;
      background: rgba(180,150,100,0.15); border-radius: 30px;
      border: 1px solid rgba(200,170,120,0.3);
    }
    #blocker .note {
      margin-top: 28px; font-size: 0.75rem; color: #7a7060; max-width: 300px; line-height: 1.45;
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.6; } 50% { opacity: 1; }
    }

    #fps {
      position: absolute; top: 8px; right: 10px; font-size: 0.65rem;
      color: rgba(180,170,150,0.4); display: none;
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>

  <div id="ui">
    <div id="title">
      <h1>ATTACK ON TITAN</h1>
      <p>Forest of Giant Trees</p>
    </div>

    <div id="joystick-zone">
      <div id="joystick-base">
        <div id="joystick-stick"></div>
      </div>
    </div>

    <div id="sprint-btn">CHẠY</div>
    <div id="look-hint">Vuốt màn hình<br>để nhìn quanh</div>
    <div id="desktop-hint">
      <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> Di chuyển · <kbd>Chuột</kbd> Nhìn · <kbd>Shift</kbd> Chạy
    </div>
    <div id="fps"></div>
  </div>

  <div id="blocker">
    <h2>PHONG CẢNH<br>ATTACK ON TITAN</h2>
    <p>Khám phá rừng cây khổng lồ</p>
    <p class="hint">CHẠM ĐỂ BẮT ĐẦU</p>
    <p class="note">
      Android: Vuốt màn hình để nhìn<br>
      Dùng joystick bên trái để di chuyển
    </p>
  </div>

  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
    }
  }
  </script>

  <script type="module">
    import * as THREE from 'three';

    const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) ||
                     ('ontouchstart' in window) || navigator.maxTouchPoints > 0;

    const container = document.getElementById('canvas-container');
    const blocker = document.getElementById('blocker');
    const joystickBase = document.getElementById('joystick-base');
    const joystickStick = document.getElementById('joystick-stick');
    const sprintBtn = document.getElementById('sprint-btn');
    const lookHint = document.getElementById('look-hint');
    const desktopHint = document.getElementById('desktop-hint');
    const fpsEl = document.getElementById('fps');

    if (isMobile) {
      joystickBase.style.display = 'block';
      sprintBtn.style.display = 'flex';
      lookHint.style.display = 'block';
    } else {
      desktopHint.style.display = 'block';
    }

    // ============ SCENE ============
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x7a90a8);
    scene.fog = new THREE.FogExp2(0x8ba0b0, 0.0017);

    const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 2000);
    camera.position.set(0, 7.5, 85);
    camera.rotation.order = 'YXZ';

    const renderer = new THREE.WebGLRenderer({ antialias: !isMobile, powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2));
    renderer.shadowMap.enabled = !isMobile;
    if (!isMobile) renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    container.appendChild(renderer.domElement);

    // Lights
    scene.add(new THREE.AmbientLight(0xb0c4d8, 0.55));
    const sun = new THREE.DirectionalLight(0xfff2e0, 1.3);
    sun.position.set(120, 180, 80);
    if (!isMobile) {
      sun.castShadow = true;
      sun.shadow.mapSize.set(1024, 1024);
      sun.shadow.camera.near = 20;
      sun.shadow.camera.far = 500;
      sun.shadow.camera.left = -180;
      sun.shadow.camera.right = 180;
      sun.shadow.camera.top = 180;
      sun.shadow.camera.bottom = -180;
    }
    scene.add(sun);
    scene.add(new THREE.HemisphereLight(0x88aacc, 0x3a4a2a, 0.4));

    // Ground
    const groundGeo = new THREE.PlaneGeometry(1200, 1200, isMobile ? 40 : 70, isMobile ? 40 : 70);
    const pos = groundGeo.attributes.position;
    for (let i = 0; i < pos.count; i++) {
      const x = pos.getX(i), y = pos.getY(i);
      pos.setZ(i, Math.sin(x * 0.013) * 3.5 + Math.cos(y * 0.011) * 2.8 + (Math.random() - 0.5));
    }
    groundGeo.computeVertexNormals();
    const ground = new THREE.Mesh(groundGeo, new THREE.MeshStandardMaterial({
      color: 0x4a6b38, roughness: 0.93, metalness: 0.03
    }));
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    // Wall
    function createWall(len, h, th, x, z) {
      const g = new THREE.Group();
      const mat = new THREE.MeshStandardMaterial({ color: 0x8a7a66, roughness: 0.88 });
      const wall = new THREE.Mesh(new THREE.BoxGeometry(len, h, th), mat);
      wall.position.y = h / 2; wall.castShadow = true; wall.receiveShadow = true;
      g.add(wall);
      const top = new THREE.Mesh(new THREE.BoxGeometry(len + 3, 4, th + 3), mat);
      top.position.y = h + 1.5; top.castShadow = true; g.add(top);
      g.position.set(x, 0, z);
      scene.add(g);
    }
    createWall(380, 55, 16, 0, -320);

    // Giant trees
    const treeGroup = new THREE.Group();
    scene.add(treeGroup);

    function createGiantTree(x, z, scale = 1) {
      const g = new THREE.Group();
      const trunkH = (48 + Math.random() * 36) * scale;
      const trunkR = (2.4 + Math.random() * 2.2) * scale;
      const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(trunkR * 0.65, trunkR, trunkH, isMobile ? 5 : 7),
        new THREE.MeshStandardMaterial({
          color: new THREE.Color().setHSL(0.07, 0.28, 0.15 + Math.random() * 0.1),
          roughness: 0.95
        })
      );
      trunk.position.y = trunkH / 2; trunk.castShadow = true; g.add(trunk);

      const cMat = new THREE.MeshStandardMaterial({
        color: new THREE.Color().setHSL(0.27 + Math.random() * 0.06, 0.45, 0.2 + Math.random() * 0.1),
        roughness: 0.9
      });
      const layers = isMobile ? 2 : 3;
      for (let i = 0; i < layers; i++) {
        const r = (10 + Math.random() * 8) * scale * (1 - i * 0.15);
        const canopy = new THREE.Mesh(new THREE.ConeGeometry(r, 15 * scale, isMobile ? 5 : 6), cMat);
        canopy.position.y = trunkH * 0.5 + i * 12 * scale;
        canopy.castShadow = true; g.add(canopy);
      }
      g.position.set(x, 0, z);
      treeGroup.add(g);
    }

    const treeCount = isMobile ? 55 : 90;
    for (let i = 0; i < treeCount; i++) {
      const angle = Math.random() * Math.PI * 2;
      const dist = 50 + Math.random() * 220;
      const x = Math.cos(angle) * dist + (Math.random() - 0.5) * 40;
      const z = Math.sin(angle) * dist - 20 + (Math.random() - 0.5) * 70;
      if (Math.hypot(x, z - 85) < 48) continue;
      createGiantTree(x, z, 0.8 + Math.random() * 0.4);
    }
    for (let i = 0; i < (isMobile ? 20 : 35); i++) {
      createGiantTree((Math.random() - 0.5) * 280, -180 - Math.random() * 140, 0.9 + Math.random() * 0.35);
    }

    // Small trees
    for (let i = 0; i < (isMobile ? 25 : 45); i++) {
      const x = (Math.random() - 0.5) * 380;
      const z = 45 + Math.random() * 170;
      if (Math.abs(x) < 28 && z < 100) continue;
      const g = new THREE.Group();
      const h = 6 + Math.random() * 9;
      const t = new THREE.Mesh(
        new THREE.CylinderGeometry(0.28, 0.4, h, 5),
        new THREE.MeshStandardMaterial({ color: 0x3a2818, roughness: 1 })
      );
      t.position.y = h / 2; g.add(t);
      const c = new THREE.Mesh(
        new THREE.SphereGeometry(2.8 + Math.random() * 1.8, 5, 4),
        new THREE.MeshStandardMaterial({ color: 0x386b30, roughness: 0.9 })
      );
      c.position.y = h + 1; g.add(c);
      g.position.set(x, 0, z);
      scene.add(g);
    }

    // Titans
    function makeTitan(x, z, scale, col) {
      const g = new THREE.Group();
      const mat = new THREE.MeshStandardMaterial({ color: col, roughness: 1 });
      const body = new THREE.Mesh(new THREE.BoxGeometry(14, 36, 8), mat);
      body.position.y = 24; g.add(body);
      const head = new THREE.Mesh(new THREE.BoxGeometry(10, 12, 9), mat);
      head.position.y = 48; g.add(head);
      const armL = new THREE.Mesh(new THREE.BoxGeometry(4, 24, 4), mat);
      armL.position.set(-12, 26, 0); armL.rotation.z = 0.2; g.add(armL);
      const armR = new THREE.Mesh(new THREE.BoxGeometry(4, 24, 4), mat);
      armR.position.set(12, 26, 0); armR.rotation.z = -0.15; g.add(armR);
      g.position.set(x, 0, z); g.scale.setScalar(scale);
      scene.add(g);
    }
    makeTitan(170, -380, 1.8, 0x2a2420);
    makeTitan(-210, -410, 1.4, 0x1e1915);

    // ============ CONTROLS ============
    let playing = false;
    let yaw = 0, pitch = 0;
    const move = { forward: 0, right: 0 }; // -1 to 1
    let sprint = false;
    const velocity = new THREE.Vector3();
    const direction = new THREE.Vector3();

    // --- Joystick (mobile) ---
    let joyActive = false;
    let joyId = null;
    let joyOrigin = { x: 0, y: 0 };
    const JOY_MAX = 42;

    function updateJoystick(dx, dy) {
      const dist = Math.hypot(dx, dy);
      const clamped = Math.min(dist, JOY_MAX);
      const angle = Math.atan2(dy, dx);
      const sx = Math.cos(angle) * clamped;
      const sy = Math.sin(angle) * clamped;
      joystickStick.style.transform = `translate(calc(-50% + ${sx}px), calc(-50% + ${sy}px))`;
      move.right = sx / JOY_MAX;
      move.forward = -sy / JOY_MAX;
    }

    function resetJoystick() {
      joyActive = false;
      joyId = null;
      joystickStick.style.transform = 'translate(-50%, -50%)';
      move.forward = 0;
      move.right = 0;
    }

    // --- Touch look (right side / anywhere not joystick) ---
    let lookId = null;
    let lastLookX = 0, lastLookY = 0;
    const LOOK_SENS = 0.0045;

    function onTouchStart(e) {
      e.preventDefault();
      if (!playing) return;

      for (const t of e.changedTouches) {
        const x = t.clientX;
        const y = t.clientY;

        // Left side → joystick
        if (x < window.innerWidth * 0.45 && y > window.innerHeight * 0.4) {
          if (!joyActive) {
            joyActive = true;
            joyId = t.identifier;
            joyOrigin.x = x;
            joyOrigin.y = y;
            // move base to finger
            joystickBase.style.left = (x - 55) + 'px';
            joystickBase.style.bottom = (window.innerHeight - y - 55) + 'px';
          }
        } else {
          // Look
          if (lookId === null) {
            lookId = t.identifier;
            lastLookX = x;
            lastLookY = y;
          }
        }
      }
    }

    function onTouchMove(e) {
      e.preventDefault();
      if (!playing) return;

      for (const t of e.changedTouches) {
        if (t.identifier === joyId) {
          updateJoystick(t.clientX - joyOrigin.x, t.clientY - joyOrigin.y);
        } else if (t.identifier === lookId) {
          const dx = t.clientX - lastLookX;
          const dy = t.clientY - lastLookY;
          lastLookX = t.clientX;
          lastLookY = t.clientY;
          yaw -= dx * LOOK_SENS;
          pitch -= dy * LOOK_SENS;
          pitch = Math.max(-1.4, Math.min(1.4, pitch));
        }
      }
    }

    function onTouchEnd(e) {
      for (const t of e.changedTouches) {
        if (t.identifier === joyId) resetJoystick();
        if (t.identifier === lookId) lookId = null;
      }
    }

    // Sprint button
    sprintBtn.addEventListener('touchstart', (e) => {
      e.preventDefault();
      sprint = true;
      sprintBtn.classList.add('active');
    });
    sprintBtn.addEventListener('touchend', () => {
      sprint = false;
      sprintBtn.classList.remove('active');
    });
    sprintBtn.addEventListener('touchcancel', () => {
      sprint = false;
      sprintBtn.classList.remove('active');
    });

    // Desktop keyboard + pointer lock style look
    const keys = {};
    document.addEventListener('keydown', (e) => { keys[e.code] = true; if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') sprint = true; });
    document.addEventListener('keyup', (e) => { keys[e.code] = false; if (e.code === 'ShiftLeft' || e.code === 'ShiftRight') sprint = false; });

    let pointerLocked = false;
    document.addEventListener('mousemove', (e) => {
      if (!playing || isMobile) return;
      if (document.pointerLockElement === document.body) {
        yaw -= e.movementX * 0.0022;
        pitch -= e.movementY * 0.0022;
        pitch = Math.max(-1.4, Math.min(1.4, pitch));
      }
    });

    // Start
    blocker.addEventListener('click', startGame);
    blocker.addEventListener('touchend', (e) => {
      e.preventDefault();
      startGame();
    });

    function startGame() {
      playing = true;
      blocker.style.display = 'none';
      if (!isMobile) {
        document.body.requestPointerLock?.();
      }
      // reset joystick position
      joystickBase.style.left = '28px';
      joystickBase.style.bottom = '36px';
    }

    // Touch events on document for look + joystick
    document.addEventListener('touchstart', onTouchStart, { passive: false });
    document.addEventListener('touchmove', onTouchMove, { passive: false });
    document.addEventListener('touchend', onTouchEnd);
    document.addEventListener('touchcancel', onTouchEnd);

    // ============ ANIMATION ============
    const clock = new THREE.Clock();
    let prev = performance.now();
    let frames = 0, fpsTime = 0;

    function animate() {
      requestAnimationFrame(animate);
      const now = performance.now();
      const delta = Math.min((now - prev) / 1000, 0.07);
      prev = now;

      // FPS counter (optional)
      frames++;
      if (now - fpsTime > 1000) {
        fpsEl.textContent = frames + ' fps';
        frames = 0; fpsTime = now;
      }

      if (playing) {
        // Desktop keys
        if (!isMobile) {
          move.forward = (keys['KeyW'] ? 1 : 0) + (keys['KeyS'] ? -1 : 0);
          move.right = (keys['KeyD'] ? 1 : 0) + (keys['KeyA'] ? -1 : 0);
        }

        // Apply rotation
        camera.rotation.y = yaw;
        camera.rotation.x = pitch;

        // Movement
        velocity.x -= velocity.x * 8 * delta;
        velocity.z -= velocity.z * 8 * delta;

        direction.set(move.right, 0, move.forward);
        if (direction.lengthSq() > 0) direction.normalize();

        const speed = sprint ? 36 : 16;
        const forward = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);
        const right = new THREE.Vector3(1, 0, 0).applyAxisAngle(new THREE.Vector3(0, 1, 0), yaw);

        camera.position.addScaledVector(forward, direction.z * speed * delta);
        camera.position.addScaledVector(right, direction.x * speed * delta);

        // Keep height
        camera.position.y = 7.5;
        camera.position.x = THREE.MathUtils.clamp(camera.position.x, -450, 450);
        camera.position.z = THREE.MathUtils.clamp(camera.position.z, -450, 450);
      }

      // Tree sway
      const t = clock.getElapsedTime();
      treeGroup.children.forEach((tree, i) => {
        tree.rotation.z = Math.sin(t * 0.3 + i * 0.5) * 0.012;
      });

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // Prevent pull-to-refresh etc.
    document.body.addEventListener('touchmove', (e) => {
      if (playing) e.preventDefault();
    }, { passive: false });
  </script>
</body>
</html>
